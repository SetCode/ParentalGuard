<?xml version="1.0" encoding="utf-8"?>
<!-- 全屏限制遮罩：大图标 + 儿童短句 + 超大倒计时为主，文字说明仅作家长辅助 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E6101827"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_overlay_card"
        android:elevation="8dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="26dp"
        android:paddingEnd="24dp"
        android:paddingBottom="22dp">

        <ImageView
            android:id="@+id/overlayIcon"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:contentDescription="当前限制状态图标"
            android:padding="22dp"
            android:src="@drawable/kid_stop" />

        <TextView
            android:id="@+id/overlayKidTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="不能玩哦"
            android:textColor="@color/danger"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/overlayTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="设备已锁定"
            android:textColor="@color/text_sub"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/overlayCountdownLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="还要等多久"
            android:textColor="@color/text_sub"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/overlayCountdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="--:--:--"
            android:textColor="@color/primary"
            android:textSize="46sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/overlayProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="8dp"
            android:max="100" />

        <TextView
            android:id="@+id/overlayReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text=""
            android:textColor="@color/text_main"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/overlayExtra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text=""
            android:textColor="@color/text_sub"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnGoHome"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_button"
            android:drawableStart="@drawable/ic_action_home"
            android:drawablePadding="10dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="回桌面"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnParentEntry"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:text="家长设置（需密码）"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
